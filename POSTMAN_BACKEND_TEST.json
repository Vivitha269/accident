{
  "info": {
    "name": "AI Accident Backend Endpoints Test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "2. Register Device",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.environment.set(\"testUserId\", jsonData.user.userId);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"test-user-{{ $randomUUID }}\",\n  \"name\": \"John Doe\",\n  \"fcmToken\": \"fcm_dummy_token_123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/register_device",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "register_device"]
        }
      }
    },
    {
      "name": "3. Accident Report V1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{testUserId}}\",\n  \"name\": \"John Doe\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946,\n  \"deviceId\": \"device-{{ $randomUUID }}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/accidents/accident",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accidents", "accident"]
        }
      }
    },
    {
      "name": "4. Accident Report V2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reportId\": \"report-{{ $randomUUID }}\",\n  \"userId\": \"{{testUserId}}\",\n  \"latitude\": 13.0827,\n  \"longitude\": 80.2707,\n  \"timestamp\": 1699123456789\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/accidents/report_accident",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accidents", "report_accident"]
        }
      }
    },
    {
      "name": "5. Trigger Alerts (use accidentId from V1/V2 response)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/accidents/trigger_alerts/{{accidentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accidents", "trigger_alerts", "{{accidentId}}"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "testUserId",
      "value": ""
    },
    {
      "key": "accidentId",
      "value": "paste_accidentId_here_from_previous_response"
    }
  ]
}
