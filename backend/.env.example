# Backend Environment Variables

PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CLIENT_URL=http://localhost:3000

# Firebase - copy service account JSON to backend/
# FIREBASE_PROJECT_ID=ai-accident-fbsvc

# Twilio for SMS backup (free tier trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# FCM Server Key (if needed for topic messaging)
FCM_SERVER_KEY=

# OSRM / OpenStreetMap (free)
OSRM_SERVER=http://router.project-osrm.org
