        {
          "name": "POST Simple Accident (30s timer)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ANDROID_PHONE_001\",\n  \"latitude\": 13.0827,\n  \"longitude\": 80.2707,\n  \"status\": \"accident_detected\",\n  \"name\": \"John Doe\",\n  \"user_id\": \"test-user-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accident",
              "host": ["{{baseUrl}}"],
              "path": ["accident"]
            },
            "description": "This is the simple endpoint from main_fastapi.py that starts a 30-second countdown in the terminal. Note: The corresponding /accident/confirm endpoint is missing from the code."
          }
        }
      ]
    },
