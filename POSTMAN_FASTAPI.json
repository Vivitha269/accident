                "request": {
                  "method": "POST",
                  "header": [{"key": "Content-Type", "value": "application/json"}],
                  "body": {
                    "mode": "raw",
                    "raw": "{\n  \"reportId\": \"report-{{ $randomUUID }}\",\n  \"userId\": \"{{userId}}\",\n  \"latitude\": 28.6139,\n  \"longitude\": 77.2090,\n  \"timestamp\": \"2024-01-01T12:00:00Z\"\n}"
                  },
                  "url": {
                    "raw": "{{baseUrl}}/api/accidents/report_accident",
